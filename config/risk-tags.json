{
  "version": 1,
  "about": "Default risk tags for scripts/risk-tags.sh (workflows/bureau-lite.md). Patterns are Python regular expressions matched case-insensitively. `paths` match a changed file's repo-relative path; `lines` match an added or removed line of the diff. A tag with `line_scope` only counts line matches inside files whose path matches line_scope. class `review` = run the cold build-diff Challenger on that unit; class `escalate` = the run is no longer a bureau-lite run, stop and checkpoint. A project may ADD tags or patterns through a ```json risk_tags``` block in project-context.md; it cannot remove or downgrade any tag here.",
  "ignore_paths": [
    "\\.(md|mdx|markdown|rst|txt|adoc)$",
    "(^|/)docs?/",
    "(^|/)(package-lock\\.json|npm-shrinkwrap\\.json|yarn\\.lock|pnpm-lock\\.yaml|bun\\.lockb?|poetry\\.lock|uv\\.lock|Pipfile\\.lock|Cargo\\.lock|Gemfile\\.lock|go\\.sum|composer\\.lock)$",
    "\\.(png|jpe?g|gif|webp|ico|svg|woff2?|ttf|otf|mp4|mov|pdf)$"
  ],
  "tags": [
    {
      "id": "oauth-auth",
      "class": "review",
      "description": "OAuth flows, auth callbacks, authentication and authorization checks",
      "paths": [
        "(^|/)(auth|oauth2?|authn|authz|login|logout|sso|saml|oidc|sessions?|permissions?|acl|rbac|policies)(/|[._-]|$)"
      ],
      "lines": [
        "oauth",
        "authenticat",
        "authoriz",
        "redirect_uri|callback_url|auth_callback",
        "\\bpkce\\b|code_verifier|code_challenge",
        "\\bcsrf\\b|\\bxsrf\\b",
        "\\bjwt\\b|\\bjwks?\\b|bearer\\s",
        "\\bsaml\\b|\\boidc\\b|openid",
        "is_admin|has_role|requires?_role|login_required|permission_required|has_perm"
      ]
    },
    {
      "id": "tokens-secrets",
      "class": "review",
      "description": "Token storage, secret store, credentials, keys and crypto",
      "paths": [
        "(^|/)(secrets?|credentials?|creds|keys|keychain|keyring|vault|tokens?|crypto)(/|[._-]|$)",
        "(^|/)\\.env(\\.|$)",
        "\\.(pem|key|p12|pfx|jks)$"
      ],
      "lines": [
        "access_?token|refresh_?token|id_?token|auth_?token|token_?store|store_?token",
        "client_?secret|api_?key|private_?key|signing_?key",
        "secret",
        "credential",
        "password|passwd|passphrase",
        "\\bencrypt|\\bdecrypt|\\bfernet\\b|\\bhmac\\b|\\bkms\\b|\\baes\\b|\\bnacl\\b|libsodium",
        "keyring|keychain"
      ]
    },
    {
      "id": "network-egress",
      "class": "review",
      "description": "Outbound network calls from the server side, webhooks, host allowlists",
      "paths": [
        "(^|/)webhooks?(/|[._-]|$)"
      ],
      "lines": [
        "\\bhttpx\\b|\\baiohttp\\b|\\brequests\\.(get|post|put|patch|delete|head|request|session)\\b",
        "urllib\\.request|urlopen|http\\.client|\\bpycurl\\b",
        "\\baxios\\b|node-fetch|\\bundici\\b|\\bgot\\(|\\bky\\(",
        "\\bcurl\\s|\\bwget\\s",
        "\\bsocket\\.|websocket|\\bgrpc\\b",
        "webhook",
        "allowed_?hosts|allowed_?origins|allowed_?domains|trusted_?hosts|\\bcors\\b|egress"
      ]
    },
    {
      "id": "tool-allowlist",
      "class": "review",
      "description": "Agent tool allowlists, MCP server config, permission rules",
      "paths": [
        "(^|/)\\.claude/settings[^/]*\\.json$",
        "(^|/)\\.mcp\\.json$",
        "(^|/)[^/]*mcp[^/]*\\.(json|ya?ml|toml)$"
      ],
      "lines": [
        "allowed_?tools|disallowed_?tools|tool_?allow_?list",
        "allow_?list|deny_?list|block_?list",
        "--tools\\b|--allowed-tools|--disallowed-tools|permission_?mode|dangerously",
        "mcp_?servers"
      ]
    },
    {
      "id": "redaction",
      "class": "review",
      "description": "Redaction, PII scrubbing, logging of sensitive values",
      "paths": [
        "(^|/)(redact|redaction|scrub|sanitize|pii)[^/]*(/|$)"
      ],
      "lines": [
        "redact",
        "\\bscrub",
        "sanitiz",
        "\\bpii\\b",
        "\\bmask_|masked_|\\bunmask",
        "log\\w*\\(.*(token|secret|password|authorization|cookie)"
      ]
    },
    {
      "id": "durable-state",
      "class": "review",
      "description": "Additive schema migrations and DDL",
      "paths": [
        "(^|/)(migrations?|alembic|db/migrate|schema)(/|\\.|$)",
        "\\.sql$"
      ],
      "lines": [
        "\\bcreate\\s+table\\b|\\balter\\s+table\\b|\\bcreate\\s+(unique\\s+)?index\\b",
        "\\badd_column\\b|\\bcreate_table\\b|\\badd_index\\b",
        "\\bop\\.(add|alter|create)_"
      ]
    },
    {
      "id": "external-irreversible",
      "class": "review",
      "description": "Sends, deletes and infra mutations that cannot be pulled back",
      "paths": [],
      "lines": [
        "send_?(mail|email|sms|message|notification)",
        "\\bsendgrid\\b|\\btwilio\\b|\\bpostmark\\b|\\bmailgun\\b|\\bresend\\.|\\bnodemailer\\b|\\bsmtplib\\b",
        "sns\\.publish|\\bses\\.send|route53|dns_?record",
        "vercel\\s+(deploy|--prod)|wrangler\\s+(deploy|publish)|kubectl\\s+(apply|delete)|terraform\\s+(apply|destroy)",
        "\\brm\\s+-[a-z]*r[a-z]*f|shutil\\.rmtree|\\bunlink\\(|os\\.remove\\("
      ]
    },
    {
      "id": "concurrency",
      "class": "review",
      "description": "Locks, transactions, schedulers and read-modify-write on shared state",
      "paths": [
        "(^|/)(schedulers?|cron|crontabs?|celery|workers)(/|\\.[a-z]+$)",
        "\\.plist$"
      ],
      "lines": [
        "\\bmutex\\b|\\bsemaphore\\b|\\bflock\\b|advisory_?lock|\\.lock\\(|\\block\\(|threading\\.Lock|asyncio\\.Lock",
        "for\\s+update\\b|\\bbegin\\s+transaction\\b|\\.transaction\\(|\\batomic\\(|select_for_update",
        "idempoten|compare_?and_?swap|dedup",
        "\\bcron\\b|crontab|apscheduler|\\bcelery\\b|beat_schedule|\\bscheduler\\b|StartInterval|StartCalendarInterval"
      ]
    },
    {
      "id": "money",
      "class": "escalate",
      "description": "Money movement, pricing, ledgers and balances",
      "paths": [
        "(^|/)(billing|payments?|payouts?|ledgers?|pricing|invoices?|wallets?|checkout)(/|[._-]|$)"
      ],
      "lines": [
        "\\bstripe\\b|payment_?intent|\\bpaypal\\b|\\bbraintree\\b",
        "\\bpayouts?\\b|\\brefunds?\\b|\\binvoices?\\b|\\bledgers?\\b|\\bbilling\\b",
        "amount_?cents|\\bcurrency\\b|\\bpricing\\b|\\bwallets?\\b|credit_?balance|\\bdebit\\b"
      ]
    },
    {
      "id": "destructive-migration",
      "class": "escalate",
      "description": "Migrations that drop, rename, truncate or rewrite existing data",
      "paths": [],
      "line_scope": "(^|/)(migrations?|alembic|db/migrate|schema|sql)(/|\\.|$)|\\.sql$",
      "lines": [
        "\\bdrop\\s+(table|column|index|schema|database|constraint)\\b",
        "\\btruncate\\b",
        "\\bdelete\\s+from\\b",
        "\\bupdate\\s+\\S+\\s+set\\b",
        "\\balter\\s+table\\s+\\S+\\s+(drop|rename)\\b|\\brename\\s+(column|to)\\b",
        "\\b(remove_column|drop_table|drop_column|rename_column|change_column)\\b",
        "\\bop\\.(drop|rename)_|\\bop\\.execute\\("
      ]
    }
  ]
}
