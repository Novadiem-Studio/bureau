{
  "runtime": "openrouter",
  "description": "OpenRouter is metered API for cheap or specialized non-build passes (article/topic/data via model-pass.sh). It is not a Bureau build host. Do not start execute-plan or other code runs with --runtime openrouter. Replace aliases in Mission Control or a local overlay only for those non-build passes.",
  "capabilities": {
    "supports_fresh_context_subagents": "runtime-dependent",
    "supports_parallel_subagents": "runtime-dependent",
    "supports_filesystem_tools": "host-dependent",
    "supports_browser_tools": "host-dependent",
    "supports_reasoning_effort": "provider-dependent"
  },
  "tiers": {
    "cheap": { "model": "openrouter:cheap", "notes": "Local/Mission Control alias." },
    "standard": { "model": "openrouter:standard", "notes": "Local/Mission Control alias." },
    "strong": { "model": "openrouter:strong", "notes": "Local/Mission Control alias." },
    "frontier": { "model": "openrouter:frontier", "notes": "Local/Mission Control alias." },
    "escalated": { "model": "openrouter:escalated", "notes": "Local/Mission Control alias." }
  }
}
