{
  "version": 2,
  "description": "Provider-neutral role policy. Resolve with scripts/resolve-model-routing.sh, then copy the result to RUN_DIR/model-routing.json.",
  "default_runtime": "claude",
  "host_policy": {
    "claude": {
      "allowed_spawn_models": [
        "haiku",
        "sonnet",
        "opus",
        "fable"
      ],
      "forbidden": [
        "premium"
      ],
      "note": "haiku/sonnet/opus defaults; fable available for escalation tiers (frontier/escalated) only \u2014 re-enabled Jul 2026. haiku is the cheap rung (Scoot)."
    },
    "openai": {
      "allowed_spawn_models": [
        "gpt-5.6-terra",
        "gpt-5.6-sol"
      ],
      "allowed_exec_models": [
        "gpt-5.3-codex-spark"
      ],
      "forbidden": [],
      "note": "Codex host: native subagent spawns use gpt-5.6-terra or gpt-5.6-sol. gpt-5.3-codex-spark is allowed only through the granular-ui-fast one-shot exec profile. Pass model and reasoning effort explicitly on every launch."
    },
    "grok": {
      "allowed_spawn_models": [
        "grok-4.3",
        "grok-4.6"
      ],
      "allowed_exec_models": [
        "grok-build-0.1"
      ],
      "forbidden": [],
      "note": "Grok Bot host: native specialist spawns use grok-4.3 (cheap/standard) or grok-4.6 (strong/frontier/escalated). grok-build-0.1 is exec-only until a one-shot helper exists. Pass model and reasoning effort explicitly on every launch. Live transport is Grok Bot Task/executor (GROK.md); scripts/run-grok-specialist.sh --plan is the audit record."
    }
  },
  "manual_experiments": [
    "conductor-sonnet"
  ],
  "tiers": [
    "cheap",
    "standard",
    "strong",
    "frontier",
    "escalated"
  ],
  "execution_profiles": {
    "granular-ui-fast": {
      "description": "Fast first-pass implementation for a bounded, text-only change to one existing frontend surface.",
      "allowed_workflows": [
        "execute-plan"
      ],
      "first_attempt_only": true,
      "requires_all": [
        "existing_frontend_surface",
        "single_component_or_style_boundary",
        "text_only_inputs",
        "known_local_validation_command"
      ],
      "disqualify_when": [
        "new_feature_or_architecture",
        "new_state_api_navigation_or_contract",
        "new_dependency_or_generated_files",
        "cross_coder_seam",
        "auth_data_money_or_irreversible_effect",
        "image_or_visual_fidelity_judgment",
        "critic_revision_or_retry",
        "broad_or_ambiguous_scope"
      ],
      "fallback": "role_default"
    }
  },
  "roles": {
    "conductor": {
      "agent": "The Conductor",
      "default_tier": "strong",
      "allowed": [
        "standard",
        "strong",
        "frontier",
        "escalated"
      ],
      "fresh_context_required": false,
      "lock": false,
      "escalate_when": [
        "hard_adjudication",
        "conflicting_specialists",
        "second_critic_loop",
        "checkpoint_decision"
      ],
      "deescalate_when": [
        "routing_only",
        "budget_pressure"
      ]
    },
    "challenger": {
      "agent": "The Challenger",
      "default_tier": "strong",
      "allowed": [
        "strong",
        "frontier",
        "escalated"
      ],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": [
        "final_gate",
        "second_critic_loop",
        "high_stakes_backend_or_security",
        "prior_review_missed_issue"
      ],
      "deescalate_when": [
        "low_risk_docs_review_with_frontier_followup"
      ]
    },
    "architect": {
      "agent": "The Architect",
      "default_tier": "strong",
      "allowed": [
