{
  "version": 2,
  "description": "Provider-neutral role policy. Resolve with scripts/resolve-model-routing.sh, then copy the result to RUN_DIR/model-routing.json.",
  "default_runtime": "claude",
  "host_policy": {
    "claude": {
      "allowed_spawn_models": ["haiku", "sonnet", "opus", "fable"],
      "forbidden": ["premium"],
      "note": "haiku/sonnet/opus defaults; fable available for escalation tiers (frontier/escalated) only — re-enabled Jul 2026. haiku is the cheap rung (Scoot)."
    }
  },
  "manual_experiments": [],
  "tiers": ["cheap", "standard", "strong", "frontier", "escalated"],
  "roles": {
    "conductor": {
      "agent": "The Conductor",
      "default_tier": "strong",
      "allowed": ["standard", "strong", "frontier", "escalated"],
      "fresh_context_required": false,
      "lock": false,
      "escalate_when": ["hard_adjudication", "conflicting_specialists", "second_critic_loop", "checkpoint_decision"],
      "deescalate_when": ["routing_only", "budget_pressure"]
    },
    "challenger": {
      "agent": "The Challenger",
      "default_tier": "strong",
      "allowed": ["strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["final_gate", "second_critic_loop", "high_stakes_backend_or_security", "prior_review_missed_issue"],
      "deescalate_when": ["low_risk_docs_review_with_frontier_followup"]
    },
    "architect": {
      "agent": "The Architect",
      "default_tier": "strong",
      "allowed": ["standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["novel_architecture", "irreversible_data_model", "critic_finds_design_gap"],
      "deescalate_when": ["small_plan_revision", "budget_pressure"]
    },
    "mage": {
      "agent": "The Mage",
      "default_tier": "strong",
      "allowed": ["standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["complex_state", "design_fidelity_failure", "mobile_web_split", "animation_or_layout_bug"],
      "deescalate_when": ["small_component_patch", "budget_pressure"]
    },
    "analyst": {
      "agent": "Analizer 2000",
      "default_tier": "standard",
      "allowed": ["cheap", "standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["huge_scope", "fuzzy_product_boundary", "regulated_domain"],
      "deescalate_when": ["narrow_existing_plan", "budget_pressure"]
    },
    "cleric": {
      "agent": "The Cleric",
      "default_tier": "standard",
      "allowed": ["cheap", "standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["ambiguous_design_handoff", "manifest_extraction_failed", "subtle_visual_drift"],
      "deescalate_when": ["straightforward_manifest_ingest", "budget_pressure"]
    },
    "spellwright": {
      "agent": "The Spellwright",
      "default_tier": "standard",
      "allowed": ["cheap", "standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["incoherent_after_one_fix", "many_cross_repo_dependencies"],
      "deescalate_when": ["approved_single_repo_plan", "budget_pressure"]
    },
    "counselor": {
      "agent": "The Counselor",
      "default_tier": "standard",
      "allowed": ["cheap", "standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["sensitive_audience", "legal_medical_political_copy"],
      "deescalate_when": ["routine_copy_review", "budget_pressure"]
    },
    "scribe": {
      "agent": "The Scribe",
      "default_tier": "standard",
      "allowed": ["standard", "strong"],
      "fresh_context_required": false,
      "lock": false,
      "escalate_when": ["long_draft", "complex_revision", "promotion_authority_step"],
      "deescalate_when": ["outline_only", "format_only"]
    },
    "systemsmith": {
      "agent": "The Systemsmith",
      "default_tier": "strong",
      "allowed": ["standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["auth", "migrations", "idempotency", "money_or_credit", "permissions", "data_integrity"],
      "deescalate_when": ["read_only_contract_audit", "small_controller_patch", "budget_pressure"]
    },
    "mechanic": {
      "agent": "The Mechanic",
      "default_tier": "standard",
      "allowed": ["cheap", "standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["prod_deploy", "irreversible_infra", "secret_handling", "database_restore_or_migration"],
      "deescalate_when": ["local_build_or_smoke_test", "budget_pressure"]
    },
    "witness": {
      "agent": "The Witness",
      "default_tier": "standard",
      "allowed": ["cheap", "standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["huge_log_volume", "many_installs_first_pass_thin"],
      "deescalate_when": ["routine_briefing", "budget_pressure"]
    },
    "tally": {
      "agent": "Tally",
      "default_tier": "standard",
      "allowed": ["cheap", "standard"],
      "fresh_context_required": true,
      "lock": true,
      "escalate_when": [],
      "deescalate_when": ["trivial_lookup", "budget_pressure"]
    },
    "scoot": {
      "agent": "Scoot",
      "default_tier": "cheap",
      "allowed": ["cheap"],
      "fresh_context_required": true,
      "lock": true,
      "escalate_when": [],
      "deescalate_when": []
    },
    "coupler": {
      "agent": "The Coupler",
      "default_tier": "standard",
      "allowed": ["standard", "strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["security_critical_seam", "repro_failure_needs_deep_trace"],
      "deescalate_when": ["routine_ui_api_smoke", "budget_pressure"]
    },
    "notary": {
      "agent": "The Notary",
      "default_tier": "strong",
      "allowed": ["strong", "frontier", "escalated"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": ["high_stakes_sealed_artifact", "irreversible_decision_under_review"],
      "deescalate_when": ["low_risk_docs_attestation", "budget_pressure"]
    },
    "delegate": {
      "agent": "The Delegate",
      "default_tier": "strong",
      "allowed": ["standard", "strong"],
      "fresh_context_required": true,
      "lock": false,
      "escalate_when": [
        "challenger_blocker_fix_thin",
        "scope_or_cost_change",
        "two_valid_approaches_robins_call",
        "sensitive_system",
        "production_or_public_action",
        "destructive_or_irreversible",
        "unresolved_blocker_or_revision_cap",
        "unexpected_scope_expansion",
        "spec_compliant_but_doctrine_violating"
      ],
      "deescalate_when": ["bundle04_benchmark_replay_clean"]
    }
  }
}
